# Optional. The site works with none of these set: sign-in buttons show "not configured yet".
# Auth.js v5 (next-auth). Generate a secret with: npx auth secret
AUTH_SECRET=
# Google OAuth client (redirect URI: http://localhost:3141/api/auth/callback/google)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app (callback URL: http://localhost:3141/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
