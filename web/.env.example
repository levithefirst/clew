# Optional. The site works with none of these set: sign-in buttons show "not configured yet".
# Auth.js v5 (next-auth). Generate a secret with: npx auth secret
AUTH_SECRET=
# Production only: AUTH_URL=https://clew-eight.vercel.app (pins callbacks + cookies to the real domain)
# Google OAuth client. Authorized redirect URIs: http://localhost:3141/api/auth/callback/google
#   and https://clew-eight.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# GitHub OAuth app (callback URL: https://clew-eight.vercel.app/api/auth/callback/github; a separate app for localhost)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
